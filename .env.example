# GitHub OAuth Configuration
# Register a new OAuth App at https://github.com/settings/applications/new
# Homepage URL: http://localhost:8080
# Authorization callback URL: http://localhost:8080/auth/callback

GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
SESSION_SECRET=random_string_for_cookie_encryption

# Security Settings
# Comma-separated list of GitHub usernames allowed to access the CMS
# Leave empty to allow all authenticated GitHub users
ALLOWED_GITHUB_USERS=
# CSRF secret for token generation (optional, will be auto-generated if not set)
CSRF_SECRET=
# GitHub OAuth scopes (comma-separated)
# Options: public_repo (public repos only), repo (public + private repos)
# Default: public_repo
GITHUB_OAUTH_SCOPES=public_repo

# App Settings
PORT=8080
APP_URL=http://localhost:8080
REPO_PATH=./repo

# Media Settings
# Maximum upload file size in MB (default: 10)
MAX_UPLOAD_SIZE_MB=10
# Directory inside article bundle for images (e.g. "src" or leave empty for bundle root)
ARTICLE_MEDIA_DIR=src
# Directory inside static/ for static images (e.g. "uploads" or leave empty for static root)
STATIC_MEDIA_DIR=images

# Hugo Server Settings
HUGO_SERVER_PORT=1314
HUGO_SERVER_BIND=127.0.0.1

# Git Settings
GIT_USER_NAME="Hugo CMS Bot"
GIT_USER_EMAIL="bot@hugo-cms.local"
GIT_BRANCH=main
GIT_REMOTE=origin
