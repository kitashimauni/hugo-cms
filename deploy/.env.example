APP_URL=https://cms.example.com
PORT=8080
GIN_MODE=release

# Match these values to the host user that owns ./repos (`id -u` / `id -g`).
HUGO_CMS_UID=1000
HUGO_CMS_GID=1000
# Host-side loopback port. The container always listens on 8080.
HUGO_CMS_HOST_PORT=8080

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
ALLOWED_GITHUB_USERS=
ALLOW_ALL_GITHUB_USERS=false
GITHUB_OAUTH_SCOPES=public_repo

# Single-site example. The repository is mounted from ./repos/techblog.
REPO_PATH=/data/repos/techblog
# Explicit ':'-separated allowlist used by mise and the tool bootstrap service.
HUGO_CMS_REPOS=/data/repos/techblog
SITE_GENERATOR=hugo
GENERATOR_RUNTIME=mise
CONTENT_DIR=content
STATIC_DIR=static
PUBLIC_DIR=public

# Multi-site example:
# SITES_CONFIG_PATH=/app/sites.yml
# HUGO_CMS_REPOS=/data/repos/techblog:/data/repos/docs

HUGO_SERVER_BIND=127.0.0.1
HUGO_SERVER_PORT=1314

GIT_REMOTE=origin
GIT_BRANCH=main
GIT_USER_NAME=HomeCMS Bot
GIT_USER_EMAIL=bot@example.com

MAX_UPLOAD_SIZE_MB=50
